# Server Configuration
HOST=0.0.0.0
PORT=8000

# Dashboard Admin Login Password (change via Settings UI or `agy-router password` after first login)
DASHBOARD_PASSWORD=123456

# Optional Master API Key (if set, seeded as initial key alongside generated sk-agy-... keys)
API_KEY=

# Default AGY model to use if client does not specify or uses generic alias
DEFAULT_MODEL=gemini-3.8-flash-high

# Path to agy executable (leave empty for automatic OS detection)
AGY_PATH=

# Enable agent tool permissions (true if you want the agent to execute tools, false for pure chat)
ALLOW_TOOL_EXECUTION=false

# Concurrency & Subprocess Timeout Limits
MAX_CONCURRENT_REQUESTS=4
AGY_TIMEOUT_SECONDS=180

# Optional custom path to cloudflared binary (leave empty for auto-detection / bin/)
# CLOUDFLARED_PATH=
